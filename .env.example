# RedForge runs fully offline by default. All integrations are optional.

# Optional telemetry (production paths; silent no-ops when unset)
REDFORCE_OTEL_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional live-LLM campaign brain (replaces the deterministic simulator)
REDFORCE_LLM_BASE_URL=https://api.openai.com/v1
REDFORCE_LLM_API_KEY=
REDFORCE_LLM_MODEL=gpt-4o-mini
